+double ResearchMedian(double &values[])
+  {
+   int count=ArraySize(values);
+   if(count<=0)
+      return 0.0;
+   double ordered[];
+   ArrayCopy(ordered,values);
+   ArraySort(ordered);
+   if((count%2)==1)
+      return ordered[count/2];
+   return (ordered[count/2-1]+ordered[count/2])/2.0;
+  }
