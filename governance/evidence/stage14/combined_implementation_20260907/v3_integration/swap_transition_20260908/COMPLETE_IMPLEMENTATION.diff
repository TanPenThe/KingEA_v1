+datetime ResearchMonthStart(const datetime value)
+  {
+   MqlDateTime parts={};
+   TimeToStruct(value,parts);
+   parts.day=1; parts.hour=0; parts.min=0; parts.sec=0;
+   return StructToTime(parts);
+  }
