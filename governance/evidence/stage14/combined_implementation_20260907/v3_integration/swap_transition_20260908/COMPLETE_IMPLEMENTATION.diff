+    def prepare_result_frame(self, manifest, configuration):
+        """Read independently retained native completion and seals; no writes.
+
+        Produces a verified ingestion payload, never acceptance or eligibility.
+        The caller must explicitly submit it to the existing ingestion hook.
+        """
+        from .decision_a_evidence import encode_archive, read_package
+        stage='native_frame_preparation'
+        try:
+            expected=validate(self,manifest,stage);key=manifest['manifest_sha256']+':'+str(configuration)
+            completion=self._read(expected['control']['native_completions'][key])
+            require(completion.get('kind')=='NATIVE_V3_COMPLETION' and completion.get('run_id')==manifest['manifest_sha256'] and
+                completion.get('configuration_id')==configuration and completion.get('profile_hash')==expected['binding']['tester_profile_sha256'] and
+                completion.get('research_invalid') is False and completion.get('containment_attempted') is False and
+                completion.get('unsupported_financial_events')==[] and completion.get('complete')==1,'NATIVE_COMPLETION_INVALID')
+            seals=expected['control']['completed_archives'][key]
+            require(type(seals) is list and completion['group_count']==len(seals),'NATIVE_COMPLETION_CARDINALITY')
+            packages=[];closes=[]
+            for reference in seals:
+                seal=self._read(reference);group=seal['binding']['group_id']
+                files=self.build_native_archive(manifest,configuration,group)
+                s,refs=verify_archive(files,seal,seal['binding'])
+                packages.append(encode_archive(files));closes.append(refs.resolve(s['terminal']['stage13_root'],'STAGE13_EVENT').decode())
+            frame=dict(complete=1,configuration_id=configuration,evidence_binding=expected['binding'],
+                authorization_binding=dict(owner_approved=True,gate='GATE1',root_sha256=expected['execution']['root_sha256'],
+                    child_sha256=expected['execution']['child_sha256'],freeze_receipt_sha256=expected['control']['freeze']['sha256'],execution_receipt_sha256=expected['control']['execution']['sha256']),
+                native_cost_packages=packages,stage13_close_frames=closes,boundary_finalization_count=completion['boundary_count'],unsupported_native_financial_events=[])
+            validate_frame(self,manifest,frame,stage)
+            return frame
+        except SuccessorEvidenceError:raise
+        except (ArithmeticError, ValueError,KeyError,TypeError,OSError,AttributeError,UnicodeError) as exc:
+            raise SuccessorEvidenceError(stage,str(exc)) from exc
