-bool ResearchHash(const string value)
-  {
-   if(StringLen(value)!=64)
-      return false;
-   for(int i=0;i<64;i++)
-     {
-      ushort character=StringGetCharacter(value,i);
-      if(!((character>='0' && character<='9') ||
-           (character>='A' && character<='F')))
-         return false;
-     }
-   return true;
-  }
