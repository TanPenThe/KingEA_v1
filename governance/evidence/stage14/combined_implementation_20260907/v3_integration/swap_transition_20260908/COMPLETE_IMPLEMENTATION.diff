+        This operation creates neither an accepted result nor execution authority.
+        """
+        stage='native_archive_preparation'
+        try:
+            expected=validate(self,manifest,stage)
+            require(type(configuration) is int and manifest['configuration_start']<=configuration<=manifest['configuration_end'], 'CONFIGURATION_SCOPE_MISMATCH')
+            key=manifest['manifest_sha256']+':'+str(configuration)
+            reference=expected['control']['native_captures'][key+':'+group]
+            raw=self._read_bytes(reference)
+            authorities={role:self._read_bytes(ref) for role,ref in expected['control']['native_artifacts'][key].items()}
+            b=expected['binding'];control=expected['control'];profile=expected['profile']
+            binding=dict(run_id=manifest['manifest_sha256'],root_hash=manifest['root_sha256'],candidate_id=b['candidate_id'],
+                configuration_hash=b['configuration_sha256'],branch=manifest['branch'],partition=manifest['partition'],group_id=group,
+                symbol=profile['symbol'],source_manifest_hash=b['source_sha256'],executable_hash=profile['executable_hash'],
+                specification_hash=ADOPTION,decision_a_hash=DECISION_A_ADOPTION,decision_s_hash=DECISION_S_ADOPTION,
+                freeze_receipt_hash=control['freeze']['sha256'],execution_receipt_hash=control['execution']['sha256'],tester_profile_hash=b['tester_profile_sha256'])
+            return assemble_native_archive(raw,binding,profile,authorities,expected_capture_hash=reference['sha256'],expected_configuration=configuration)
+        except SuccessorEvidenceError:raise
+        except (ArithmeticError, ValueError,KeyError,TypeError,OSError,AttributeError,UnicodeError) as exc:
+            raise SuccessorEvidenceError(stage,str(exc)) from exc
