+def encode_archive(files):
+    import base64
+    return canonical(dict(kind='V3_ARCHIVE_TRANSPORT',artifacts=[dict(path=p,data=base64.b64encode(v).decode('ascii')) for p,v in sorted(files.items())]))
+
