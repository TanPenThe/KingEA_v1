+def parse_json(raw):
+    require(type(raw) is bytes and 0 < len(raw) <= 10_000_000, 'ARTIFACT_BYTES_REQUIRED')
+    return json.loads(raw.decode('utf-8'), object_pairs_hook=unique,
+                      parse_constant=lambda _: require(False, 'NONFINITE_JSON'))
