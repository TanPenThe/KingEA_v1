+def set_renderer_contract_sha256():
+    return v3.digest(v3.json_bytes(dict(kind='CONFORMANCE_SET_RENDERER_CONTRACT_V1',
+                                               input_types=SET_INPUT_TYPES)))
+
+def build_layer_a(fixture, configuration_sha256, source_sha256):
+    """Serialize the closed compile-stable manifest without post-compile authority."""
+    v3.require(type(fixture) is dict and set(fixture)==FIXTURE_FIELDS,
+               'LAYER_A_FIXTURE_SCHEMA')
+    v3.require(v3.hash_value(configuration_sha256) and v3.hash_value(source_sha256),
+               'LAYER_A_AUTHORITY_HASH')
