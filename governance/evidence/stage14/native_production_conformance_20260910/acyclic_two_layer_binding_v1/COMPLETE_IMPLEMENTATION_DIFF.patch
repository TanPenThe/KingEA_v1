+
+def _reject_layer_b_cycles(value):
+    if isinstance(value,dict):
+        v3.require(not ({str(key).lower() for key in value} & LAYER_B_FORBIDDEN_KEYS),
+                   'LAYER_B_CYCLIC_FIELD')
