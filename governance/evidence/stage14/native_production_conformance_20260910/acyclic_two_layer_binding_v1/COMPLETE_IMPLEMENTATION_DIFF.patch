+
+LAYER_A_FIELDS = FIXTURE_FIELDS | {
+    'domain','configuration_sha256','source_sha256',
+    'inventory_protocol_sha256','swap_transition_rule_sha256'}
+LAYER_B_FIELDS = {
+    'domain','fixture','profile','artifacts','local_inputs','embedded_manifest',
+    'ea_source_sha256','set_renderer_contract_sha256','environment'}
+LAYER_B_ENVIRONMENT_FIELDS = {
